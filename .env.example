# Copy to .env to customize. Lines are KEY=VALUE; # starts a comment.
# Secret for login sessions. Set a long random string on any shared machine.
SECRET_KEY = e3dcb2079dd4744f998548e63f881fa4296b11d9e5b8f9db2289f0343d7b5c10
# Supabase project (login + Postgres data + Storage file uploads).
# Find these in your Supabase project: Settings -> API.
# SUPABASE_ANON_KEY takes the Publishable key (sb_publishable_...); the
# legacy anon JWT (eyJ...) also works. No other change is needed.
# Run supabase/schema.sql once in the dashboard SQL editor first.
SUPABASE_URL = https://wlgfrupflfjamvjfckpq.supabase.co
SUPABASE_ANON_KEY = sb_publishable_tFb55RY7XVxK8nZrmy-8Ow_ERpISEbo
# Optional: service_role key for terminal admin tasks only
# (e.g. python -m fincoach.storage.seed --user <uuid>). Never expose to browsers.
# SUPABASE_SERVICE_KEY =
# Support email shown on the Help page (Contact us).
# HELP_EMAIL = support@fincoach.local
# Outgoing mail for bill reminders (stdlib smtplib). Leave SMTP_HOST empty
# to disable sending; see README "Bill reminders by email" for Gmail
# app-password setup.
# SMTP_HOST = smtp.gmail.com
# SMTP_PORT = 587
# SMTP_USER = you@gmail.com
# SMTP_PASS = your-16-char-app-password
# SMTP_FROM = you@gmail.com
# Google Gemini for the assistant (optional). Without a key the assistant
# uses its built-in rule engine; with a key it answers via Gemini with
# your data as context and falls back to rules on any API error.
# Get a key at https://aistudio.google.com/app/apikey — see README.
# GEMINI_API_KEY = your-gemini-api-key
# GEMINI_MODEL = gemini-1.5-flash
# NOTE: FINCOACH_DATA is test-only (offline stub transport). Do not set it
# here; production always talks to Supabase.
